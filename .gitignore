# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Local runtime (rips, logs, locks)
logs/
output/
.tmp/
*.log
*.mkv
*.lock

# Staging workflow artifacts (not configs/*.yaml or LLM-RIP-WORKFLOW.md)
# Ignores pending/*.json, ready/*.yaml, done/*, failed/*, .probe*/.rip.*, etc.
/staging/**
!/staging/pending/
!/staging/ready/
!/staging/done/
!/staging/failed/
/staging/pending/**
!/staging/pending/.gitkeep
/staging/ready/**
!/staging/ready/.gitkeep
/staging/done/**
!/staging/done/.gitkeep
/staging/failed/**
!/staging/failed/.gitkeep

# Secrets
.env
.env.*
*credentials*

# Editor
.idea/
.vscode/

# Pytest basetemp / local test dirs (not source under tests/)
.pytest-tmp/
pytest-of-*/

# Process / shell spill (watchers, manual runs)
nohup.out
nohup*.log

# Cursor local project state
.cursor/
