# Copy to .env (gitignored) and fill in. Never commit a real key.
# systemd user units load this via EnvironmentFile. map_agent also merges it
# when calling OpenRouter (a new map can see the key without a unit restart).
# Do not restart a unit mid-rip.
#
# OpenRouter — map manifests and the three capped disc decisions
# (failure class, gap, failed verify).
# https://openrouter.ai/keys  The value is the key, not a Bearer prefix.
# A missing or blank key does not call OpenRouter and does not write a manifest.
OPENROUTER_API_KEY=

# Optional model overrides. Every call defaults to google/gemini-2.5-flash-lite
# (strict JSON, reasoning off). RIPKNIFE_LLM_MODEL overrides calls that do not
# set their own variable. A per-call variable wins.
# RIPKNIFE_LLM_MODEL=
# RIPKNIFE_LLM_MAP_MODEL=
# RIPKNIFE_LLM_FAILURE_MODEL=
# RIPKNIFE_LLM_GAP_MODEL=
# RIPKNIFE_LLM_VERIFY_MODEL=
# RIPKNIFE_LLM_VISION_MODEL=
